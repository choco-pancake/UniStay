/* ---------- Bottom row ---------- */
.paths {
  display: block;
  margin: auto 0 0;
  padding: 0;
}

.paths-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 58px 26px;
  border-top: 1px solid #f1e7de;
  font-size: 14px;
  color: var(--ink);
  white-space: nowrap;
}

.paths-left {
  text-align: left;
}

.paths strong {
  font-weight: 700;
}

.path-links {
  display: flex;
  align-items: center;
  gap: 20px;
}

.path-links a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--brown);
  font-weight: 600;
}

.path-links a:hover {
  text-decoration: underline;
}

.path-links svg {
  width: 20px;
  height: 20px;
}
