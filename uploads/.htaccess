# Block direct execution of scripts in uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|phar|cgi|pl|exe|sh|py|rb|bat|cmd)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Disable directory listing and CGI execution
Options -Indexes

<FilesMatch "(?i)^(govid_|gov_id_|school_id_|proof_ownership_)">
    Order Deny,Allow
    Deny from all
</FilesMatch>
